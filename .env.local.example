NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé service_role Supabase — jamais exposée au navigateur, utilisée uniquement
# par le webhook Stripe pour écrire dans la base sans passer par un utilisateur connecté.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Envoi d'e-mails (module Réception) — voir resend.com
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Garage AMS <no-reply@votredomaine.ch>

# Facturation (voir dashboard.stripe.com)
NEXT_PUBLIC_APP_URL=https://votre-app.vercel.app
STRIPE_SECRET_KEY=sk_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Traduction automatique du texte libre sur le PDF (voir deepl.com/pro-api) — optionnel :
# sans cette clé, le texte libre est simplement laissé tel quel dans la langue saisie.
DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
